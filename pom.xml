<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Deliberately standalone rather than inheriting org.apache.nifi:nifi-nar-bundles.
      That parent's enforcer RequireReleaseDeps rule rejects any non-org.apache.nifi
      SNAPSHOT dependency in a nar module, which makes -SNAPSHOT development builds of
      an external bundle impossible. Versions below mirror what NiFi 1.28.1 uses.
    -->
    <groupId>org.example</groupId>
    <artifactId>nifi-starter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>nifi-starter</name>
    <description>Starter monorepo for Apache NiFi 1.28.1 extensions</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>

        <nifi.version>1.28.1</nifi.version>
        <nifi.nar.maven.plugin.version>1.5.1</nifi.nar.maven.plugin.version>

        <junit.version>5.11.1</junit.version>
        <slf4j.version>2.0.16</slf4j.version>

        <!--
          Parquet 1.17.1 rather than the 1.13.1 NiFi 1.28.1's own parquet bundle ships:
          parquet-avro at or below 1.15.0 carries CVE-2025-30065 (schema parsing can load
          arbitrary classes). 1.17.1 also targets Java 11, matching this build.
        -->
        <parquet.version>1.17.1</parquet.version>
        <hadoop.version>3.4.1</hadoop.version>

        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    </properties>

    <modules>
        <module>nifi-starter-api</module>
        <module>nifi-starter-services</module>
        <module>nifi-starter-processors</module>
        <module>nifi-starter-nar</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- This project's modules -->
            <dependency>
                <groupId>org.example</groupId>
                <artifactId>nifi-starter-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.example</groupId>
                <artifactId>nifi-starter-services</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.example</groupId>
                <artifactId>nifi-starter-processors</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- NiFi -->
            <!--
              provided, matching nifi-nar-bundles: the framework loads nifi-api from its
              own classloader, so it must never be bundled into a NAR (including
              transitively, e.g. via nifi-utils).
            -->
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-utils</artifactId>
                <version>${nifi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-mock</artifactId>
                <version>${nifi.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-standard-services-api-nar</artifactId>
                <version>${nifi.version}</version>
                <type>nar</type>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
                <scope>test</scope>
            </dependency>
            <!--
              provided for the same reason as nifi-api: NiFi supplies slf4j-api from its own
              lib/ directory. Parquet, Avro and Hadoop all pull it at compile scope, so without
              this it would be bundled into the NAR and defeat NiFi's logging routing.
            -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
                <scope>provided</scope>
            </dependency>

            <!--
              Parquet, plus the Hadoop it needs at runtime.

              parquet-hadoop reaches org.apache.hadoop.conf.Configuration and
              ParquetInputFormat's FileInputFormat superclass even on the InputFile read path,
              and parquet declares Hadoop as provided, so we have to supply it ourselves.

              hadoop-client-api and hadoop-client-runtime are the pair Hadoop publishes for
              exactly this: the API jar carries the org.apache.hadoop classes, the runtime jar
              carries their third-party dependencies with the packages relocated. Because those
              are relocated they cannot collide with parquet's or NiFi's copies, so no exclusions
              are needed anywhere in this build.
            -->
            <dependency>
                <groupId>org.apache.parquet</groupId>
                <artifactId>parquet-avro</artifactId>
                <version>${parquet.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-client-api</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.hadoop</groupId>
                <artifactId>hadoop-client-runtime</artifactId>
                <version>${hadoop.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- extensions=true registers the 'nar' packaging lifecycle -->
            <plugin>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-nar-maven-plugin</artifactId>
                <version>${nifi.nar.maven.plugin.version}</version>
                <extensions>true</extensions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
