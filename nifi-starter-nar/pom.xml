<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example</groupId>
        <artifactId>nifi-starter</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nifi-starter-nar</artifactId>
    <packaging>nar</packaging>

    <description>NAR bundling the starter API, processors and controller services</description>

    <dependencies>
        <!--
          Parent NAR. Supplies the Hadoop client libraries that ValidateParquet's
          parquet-hadoop dependency needs at runtime (hadoop-* jars are provided scope
          here, so they are not bundled). Its own parent chain runs through
          nifi-standard-shared-nar to nifi-standard-services-api-nar, so NiFi's standard
          service APIs (SSLContextService, DBCPService, RecordReaderFactory, ...) remain
          on the parent classloader as before.
          A NAR may declare at most one nar-typed dependency.
        -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-hadoop-libraries-nar</artifactId>
            <type>nar</type>
        </dependency>
        <!-- nifi-starter-api is bundled transitively via these two -->
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>nifi-starter-processors</artifactId>
        </dependency>
        <dependency>
            <groupId>org.example</groupId>
            <artifactId>nifi-starter-services</artifactId>
        </dependency>
    </dependencies>

</project>
